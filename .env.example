DATABASE_URL=postgresql://market:market@localhost:5432/market_delivered
API_HOST=127.0.0.1
API_PORT=3001
WEB_ORIGIN=http://localhost:5173

# Generate a random secret (at least 32 characters). Never commit real secrets.
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:5173
# Production verification and password-reset mail
# RESEND_API_KEY=
# EMAIL_FROM=Market Delivered <accounts@your-domain.com>

# Separate random secret for the protected cron endpoint (32+ characters).
CRON_SECRET=replace-with-a-different-random-secret-at-least-32-characters

# Server-side Google Maps API key
GOOGLE_MAPS_API_KEY=

# Vercel: deploy one project from the repository root using vercel.json.
# WEB_ORIGIN and BETTER_AUTH_URL must both be the shared public HTTPS origin.
# Leave VITE_API_URL and VITE_AUTH_URL unset to use same-origin service routing.
# No API_ORIGIN or service binding URL is needed: the browser calls the public API.
