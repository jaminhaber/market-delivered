DATABASE_URL=postgresql://market:market@localhost:5432/market_delivered
API_HOST=127.0.0.1
API_PORT=3001
ADMIN_PORT=5173
ADMIN_ORIGIN=http://localhost:5173

# Independent secrets (at least 32 characters each).
# BETTER_AUTH_SECRET also encrypts network email credentials; keep it stable.
BETTER_AUTH_SECRET=replace-with-a-random-business-secret-at-least-32-characters
ADMIN_AUTH_SECRET=replace-with-a-different-admin-secret-at-least-32-characters
CRON_SECRET=replace-with-a-third-random-secret-at-least-32-characters

# Required for production email; development logs links when absent.
# RESEND_API_KEY=
# EMAIL_FROM=Market Delivered <accounts@your-domain.com>
GOOGLE_MAPS_API_KEY=

# Browser auth origins are registered per network through the admin API/CLI.
# Silverstreak's server-only API origin and fixed network ID live in
# apps/silverstreak/.env, never in the browser bundle.
