---
import ProfileMenu from './ProfileMenu.astro';
import SiteLogo from './SiteLogo.astro';

interface Props {
  home?: boolean;
  profile: { name: string; admin: boolean } | null;
}

const { home = false, profile } = Astro.props;
---

<header class:list={['masthead', { 'home-profile': home }]}>
  {home ? (
    profile && <ProfileMenu name={profile.name} admin={profile.admin} />
  ) : (
    <>
      <a class="home-link" href="/" aria-label="Silverstreak home">
        <SiteLogo />
      </a>
      <nav aria-label="Main navigation">
        <a
          href="/order"
          aria-current={Astro.url.pathname === '/order' ? 'page' : undefined}
        >
          Order
        </a>
        <a
          href="/about"
          aria-current={Astro.url.pathname === '/about' ? 'page' : undefined}
        >
          About
        </a>
        <a
          href="/contact"
          aria-current={Astro.url.pathname === '/contact' ? 'page' : undefined}
        >
          Contact
        </a>
        {profile && <ProfileMenu name={profile.name} admin={profile.admin} />}
      </nav>
    </>
  )}
</header>
