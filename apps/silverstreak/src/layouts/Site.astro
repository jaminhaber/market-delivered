---
import '../styles/site.css';
import SiteHeader from '../components/SiteHeader.astro';
import { marketApi } from '../server/market';

interface Props {
  title?: string;
  description?: string;
  home?: boolean;
}

const {
  title = 'Silverstreak — Good things, brought home.',
  description = 'A little closer to the source. Farmers market delivery by Silverstreak.',
  home = false,
} = Astro.props;

Astro.response.headers.set('Cache-Control', 'no-store');
let profile: { name: string; admin: boolean } | null = null;
if (Astro.request.headers.has('cookie')) {
  try {
    profile = await marketApi(Astro).me.query();
  } catch {
    // Keep the public navigation available if the API cannot resolve a session.
  }
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#eeece2" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class:list={[{ 'is-home': home }]}>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <div class="site-shell">
      <SiteHeader {home} {profile} />
      <main id="main" tabindex="-1">
        <slot />
      </main>
    </div>
  </body>
</html>
