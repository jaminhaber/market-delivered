---
import Site from '../layouts/Site.astro';
---

<Site title="About us — Silverstreak">
  <section class="story" aria-labelledby="story-title">
    <div class="story-copy">
      <p class="small-label">A little closer to the source.</p>
      <h1 id="story-title">
        A market morning.
        <br />
        <em>Without the rush.</em>
      </h1>
      <p>
        Silverstreak brings the farmers market to your door. The seasonal finds,
        the everyday staples, the things that make a good meal.
      </p>
      <p>
        You order ahead. We gather your groceries at the market and bring them
        home to you. A little less running around. A little more time at the
        table.
      </p>
      <a class="button button-dark" href="/order">
        Order now <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
</Site>
