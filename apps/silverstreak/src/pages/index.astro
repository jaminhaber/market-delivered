---
import Site from '../layouts/Site.astro';
---

<Site home>
  <section class="hero" aria-labelledby="hero-title">
    <img
      class="hero-image"
      src="/images/silverstreak-landscape.jpg"
      alt="A garden path overlooking green fields and cloud-covered mountains"
      width="3752"
      height="2538"
      fetchpriority="high"
    />
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="hero-eyebrow small-label">
      <span>A little closer to the source.</span>
      <span aria-hidden="true">No. 001</span>
    </div>
    <div class="hero-content">
      <p class="small-label">Farmers market delivery</p>
      <h1 id="hero-title">
        Fresh produce.
        <br />
        <em>Delivered.</em>
      </h1>
      <div class="hero-actions">
        <a class="button button-cream" href="/order">
          Order now <span aria-hidden="true">↗</span>
        </a>
        <a class="text-link" href="/about">
          About us <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
    <p class="hero-note small-label">
      Grown with care.
      <br />
      Gathered for you.
    </p>
  </section>
</Site>
