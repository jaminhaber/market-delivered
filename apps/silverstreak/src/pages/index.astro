---
import Site from '../layouts/Site.astro';
import SiteLogo from '../components/SiteLogo.astro';
---

<Site home>
  <section class="hero" aria-labelledby="hero-title">
    <img
      class="hero-image"
      src="/images/silverstreak-oranges.png"
      alt="Oranges growing among green leaves on a sunlit tree"
      width="2732"
      height="2048"
      fetchpriority="high"
    />
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="hero-content">
      <h1 id="hero-title">
        <SiteLogo home />
      </h1>
      <a class="hero-order" href="/order">
        Order now
      </a>
      <nav class="hero-nav" aria-label="Main navigation">
        <a href="/about">About</a>
        <a href="/contact">Contact</a>
      </nav>
    </div>
  </section>
</Site>
