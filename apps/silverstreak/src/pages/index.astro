---
import ArrowUpRight from '../components/ArrowUpRight.astro';
import Site from '../layouts/Site.astro';
---

<Site home>
  <section class="hero" aria-labelledby="hero-title">
    <img
      class="hero-image"
      src="/images/silverstreak-landscape.jpg"
      alt="A garden path overlooking green fields and cloud-covered mountains"
      width="3752"
      height="2538"
      fetchpriority="high"
    />
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="hero-logo" role="img" aria-label="Silverstreak Produce"></div>
    <div class="hero-content">
      <h1 id="hero-title">
        Fresh produce.
        <br />
        <em>Delivered.</em>
      </h1>
      <div class="hero-actions">
        <a class="button button-cream" href="/order">
          Order now <ArrowUpRight />
        </a>
        <a class="text-link" href="/about">
          About us <ArrowUpRight />
        </a>
      </div>
    </div>
  </section>
</Site>
