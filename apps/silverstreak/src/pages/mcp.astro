---
import Site from '../layouts/Site.astro';
import AdminNav from '../components/AdminNav.astro';
import McpInstructionBlocks from '../components/McpInstructionBlocks.astro';
import {
  listProviders,
  listInterfaces,
  getSetupInstructions,
  getTokenSaveCommand,
  type AssistantId,
  type OAuthInterfaceId,
} from '@market/mcp-instructions';
import { marketApi, oauthRequest, messageFor } from '../server/market';

Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('Referrer-Policy', 'same-origin');
let authorized = false;
let error = '';
let endpoint = '';
let newToken = '';
const tokenFile = '.config/market-delivered/silverstreak.headers';
let tokens: {
  id: string;
  name: string;
  lastFour: string;
  revokedAt: string | null;
}[] = [];
let tokenSelected = Astro.url.searchParams.get('provider') === 'token';
let connections: { id: string; name: string | null; clientId: string }[] = [];
try {
  const api = marketApi(Astro);
  const me = await api.me.query();
  if (!me) return Astro.redirect('/account', 303);
  if (!me.admin) {
    Astro.response.status = 403;
    error = 'Administrator access is required to manage AI connections.';
  } else {
    authorized = true;
    if (Astro.request.method === 'POST') {
      if (Astro.request.headers.get('origin') !== Astro.url.origin) {
        return new Response('Origin not allowed', {
          status: 403,
          headers: { 'Cache-Control': 'no-store' },
        });
      }
      const form = await Astro.request.formData();
      if (form.get('intent') === 'disconnect') {
        const result = await oauthRequest(Astro, '/connections', {
          id: String(form.get('id') || ''),
        });
        if (!result.ok) throw new Error('Unable to disconnect the assistant.');
        return Astro.redirect('/mcp?disconnected=1', 303);
      } else if (form.get('intent') === 'create') {
        tokenSelected = true;
        newToken = (
          await api.admin.createToken.mutate({
            name: String(form.get('name') || ''),
          })
        ).token;
      } else if (form.get('intent') === 'revoke') {
        await api.admin.revokeToken.mutate({
          id: String(form.get('id') || ''),
        });
        return Astro.redirect('/mcp?provider=token', 303);
      } else {
        return new Response('Choose a valid action.', { status: 400 });
      }
    }
    tokens = await api.admin.tokens.query();
    const connected = await oauthRequest(Astro, '/connections');
    if (!connected.ok) throw new Error('Unable to load connected assistants.');
    const data = await connected.json();
    endpoint = data.resource;
    connections = data.connections;
  }
} catch (problem) {
  error = messageFor(problem);
}

const providers = listProviders();
const interfaces = listInterfaces(tokenSelected ? 'token' : 'chatgpt');
const setups = endpoint
  ? providers.flatMap((provider) =>
      listInterfaces(provider.id).map((interfaceOption) =>
        getSetupInstructions({
          ...(provider.id === 'token'
            ? {
                provider: 'token' as const,
                interface: interfaceOption.id as AssistantId,
                tokenFile,
              }
            : {
                provider: provider.id,
                interface: interfaceOption.id as OAuthInterfaceId,
              }),
          serverName: 'silverstreak',
          displayName: 'Silverstreak',
          serverUrl: endpoint,
          examplePrompt: 'Use Silverstreak to list upcoming markets.',
        }),
      ),
    )
  : [];
---

<Site title="Connect your assistant — Silverstreak">
  <section class="shop-page mcp-page">
    <p class="small-label">Silverstreak administration</p>
    <h1>Admin.</h1>
    {error && (
      <p class="shop-notice" role="alert">
        {error}
      </p>
    )}
    {authorized && (
      <>
        <AdminNav />
        <section class="mcp-setup" aria-labelledby="connect-assistant-heading">
          <h2 id="connect-assistant-heading">Connect your assistant</h2>
          <p>
            Let your assistant help with Silverstreak’s markets, stock, and
            orders.
          </p>
          <div class="mcp-choices">
            <label>
              How would you like to connect?
              <select id="setup-provider">
                {providers.map((provider) => (
                  <option
                    value={provider.id}
                    selected={
                      tokenSelected
                        ? provider.id === 'token'
                        : provider.id === 'chatgpt'
                    }
                  >
                    {provider.name}
                  </option>
                ))}
              </select>
            </label>
            <label>
              <span id="setup-interface-label">
                {tokenSelected
                  ? providers.find((item) => item.id === 'token')!
                      .interfaceLabel
                  : providers[0]!.interfaceLabel}
              </span>
              <select id="setup-surface">
                {interfaces.map((interfaceOption) => (
                  <option value={interfaceOption.id}>
                    {interfaceOption.name}
                  </option>
                ))}
              </select>
            </label>
          </div>
          {setups.map((setup) => (
            <section
              data-setup-panel
              data-provider={setup.provider.id}
              data-surface={setup.interface.id}
              aria-label={`${setup.provider.name} ${setup.interface.id} setup`}
              hidden={
                setup.provider.id !== (tokenSelected ? 'token' : 'chatgpt') ||
                setup.interface.id !== (tokenSelected ? 'chatgpt' : 'desktop')
              }
            >
              <McpInstructionBlocks blocks={setup.blocks} />
            </section>
          ))}
          <section data-token-controls hidden={!tokenSelected}>
            <form method="post" class="shop-form">
              <input type="hidden" name="intent" value="create" />
              <label>
                Token name
                <input name="name" required minlength="2" maxlength="100" />
              </label>
              <button class="button button-dark">Create token</button>
            </form>
            {newToken && (
              <>
                <p>Save this token now. It is shown only once.</p>
                <label>
                  New token
                  <input readonly value={newToken} />
                </label>
                <McpInstructionBlocks
                  blocks={[
                    {
                      type: 'copy',
                      label: 'Save token command',
                      copyLabel: 'Copy save command',
                      value: getTokenSaveCommand({
                        token: newToken,
                        tokenFile,
                      }),
                      kind: 'command',
                    },
                  ]}
                />
              </>
            )}
            <p>
              Tokens access Silverstreak only and expire after 90 days. Keep
              your token file private.
            </p>
            {tokens.map((token) => (
              <form method="post" class="shop-form">
                <p>
                  {token.name} · …{token.lastFour}
                  {token.revokedAt ? ' · Revoked' : ''}
                </p>
                {!token.revokedAt && (
                  <>
                    <input type="hidden" name="intent" value="revoke" />
                    <input type="hidden" name="id" value={token.id} />
                    <button
                      class="quiet-button"
                      aria-label={`Revoke ${token.name}`}
                    >
                      Revoke token
                    </button>
                  </>
                )}
              </form>
            ))}
          </section>
          {Astro.url.searchParams.has('disconnected') && (
            <p class="shop-notice" role="status">
              Assistant disconnected. Its access has been revoked.
            </p>
          )}
          {connections.length > 0 && (
            <details
              class="mcp-connections"
              data-oauth-controls
              hidden={tokenSelected}
            >
              <summary>Connected assistants ({connections.length})</summary>
              {connections.map((connection) => (
                <form method="post" class="shop-form">
                  <p>{connection.name || connection.clientId}</p>
                  <input type="hidden" name="intent" value="disconnect" />
                  <input type="hidden" name="id" value={connection.id} />
                  <button
                    class="quiet-button"
                    aria-label={`Disconnect ${connection.name || connection.clientId}`}
                  >
                    Disconnect
                  </button>
                </form>
              ))}
            </details>
          )}
        </section>
      </>
    )}
  </section>
</Site>

<script>
  import {
    listInterfaces,
    listProviders,
    type ProviderId,
  } from '@market/mcp-instructions';
  const provider = document.querySelector<HTMLSelectElement>('#setup-provider');
  const surface = document.querySelector<HTMLSelectElement>('#setup-surface');
  const showInstructions = () => {
    document
      .querySelectorAll<HTMLElement>('[data-token-controls]')
      .forEach((item) => (item.hidden = provider?.value !== 'token'));
    document
      .querySelectorAll<HTMLElement>('[data-oauth-controls]')
      .forEach((item) => (item.hidden = provider?.value === 'token'));
    document
      .querySelectorAll<HTMLElement>('[data-setup-panel]')
      .forEach((panel) => {
        panel.hidden =
          panel.dataset.provider !== provider?.value ||
          panel.dataset.surface !== surface?.value;
      });
  };
  provider?.addEventListener('change', () => {
    if (!surface || !provider) return;
    const previous = surface.value;
    const available = listInterfaces(provider.value as ProviderId);
    const label = document.querySelector('#setup-interface-label');
    if (label)
      label.textContent =
        listProviders().find((item) => item.id === provider.value)
          ?.interfaceLabel || '';
    const url = new URL(location.href);
    url.searchParams.set('provider', provider.value);
    history.replaceState(null, '', url);
    surface.replaceChildren(
      ...available.map((item) => new Option(item.name, item.id)),
    );
    if (available.some((item) => item.id === previous))
      surface.value = previous;
    showInstructions();
  });
  surface?.addEventListener('change', showInstructions);
  showInstructions();

  document
    .querySelectorAll<HTMLButtonElement>('[data-copy-command], [data-copy-url]')
    .forEach((button) => {
      button.addEventListener('click', async () => {
        const block = button.closest('.mcp-command');
        const text =
          button.dataset.copyUrl || block?.querySelector('code')?.textContent;
        const status = block?.querySelector('span');
        if (!text || !status) return;
        try {
          await navigator.clipboard.writeText(text);
          status.textContent = button.dataset.copyUrl
            ? 'Address copied. Paste it into your assistant.'
            : 'Copied. Paste and run it in Terminal.';
        } catch {
          status.textContent = button.dataset.copyUrl
            ? 'Select the address above and copy it.'
            : 'Select the commands above and copy them.';
        }
      });
    });
</script>
