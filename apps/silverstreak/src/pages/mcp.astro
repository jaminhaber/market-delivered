---
import Site from '../layouts/Site.astro';
import AdminNav from '../components/AdminNav.astro';
import McpInstructionBlocks from '../components/McpInstructionBlocks.astro';
import {
  listProviders,
  listInterfaces,
  getSetupInstructions,
  type ProviderId,
  type InterfaceId,
} from '@market/mcp-instructions';
import { marketApi, messageFor } from '../server/market';
Astro.response.headers.set('Cache-Control', 'no-store');
let error = '';
let connection: { url: string; connectUrl: string } | null = null;
try {
  const api = marketApi(Astro);
  const me = await api.me.query();
  if (!me) return Astro.redirect('/account', 303);
  if (!me.admin) {
    Astro.response.status = 403;
    throw new Error(
      'Administrator access is required to connect an assistant.',
    );
  }
  connection = await api.assistantConnection.query();
} catch (problem) {
  error = messageFor(problem);
}
const providers = listProviders();
const selected = Astro.url.searchParams.get('provider');
const provider: ProviderId = selected === 'claude' ? 'claude' : 'chatgpt';
const surface: InterfaceId =
  Astro.url.searchParams.get('interface') === 'terminal'
    ? 'terminal'
    : 'desktop';
const setup = connection
  ? getSetupInstructions({
      provider,
      interface: surface,
      serverName: 'silverstreak',
      displayName: 'Silverstreak',
      serverUrl: connection.url,
      approvalLabel: 'Allow access as me',
      examplePrompt: 'Use Silverstreak to list upcoming markets.',
    })
  : null;
---

<Site title="Connect your assistant — Silverstreak">
  <section class="shop-page mcp-page">
    <p class="small-label">Silverstreak administration</p>
    <h1>Admin.</h1>
    {error && (
      <p class="shop-notice" role="alert">
        {error}
      </p>
    )}
    {connection && setup && (
      <>
        <AdminNav />
        <section class="mcp-setup">
          <h2>Connect your assistant</h2>
          <p>
            Connect your assistant to Silverstreak. This connection can manage
            only Silverstreak, using your current administrator permissions.
          </p>
          <form method="get" class="mcp-choices">
            <label>
              Which assistant?
              <select name="provider" id="setup-provider">
                {providers.map((item) => (
                  <option value={item.id} selected={provider === item.id}>
                    {item.name}
                  </option>
                ))}
              </select>
            </label>
            <label>
              How do you use it?
              <select name="interface" id="setup-surface">
                {listInterfaces(provider).map((item) => (
                  <option value={item.id} selected={surface === item.id}>
                    {item.name}
                  </option>
                ))}
              </select>
            </label>
          </form>
          <McpInstructionBlocks blocks={setup.blocks} />
          <p>
            <a href={connection.connectUrl}>
              Manage assistant connections in Market Delivered
            </a>
          </p>
        </section>
      </>
    )}
  </section>
</Site>
<script>
  document
    .querySelectorAll<HTMLSelectElement>('.mcp-choices select')
    .forEach((select) =>
      select.addEventListener('change', () => select.form?.requestSubmit()),
    );
  document
    .querySelectorAll<HTMLButtonElement>('[data-copy-command], [data-copy-url]')
    .forEach((button) =>
      button.addEventListener('click', async () => {
        const block = button.closest('.mcp-command');
        const text =
          button.dataset.copyUrl || block?.querySelector('code')?.textContent;
        const status = block?.querySelector('span');
        if (!text || !status) return;
        try {
          await navigator.clipboard.writeText(text);
          status.textContent = 'Copied.';
        } catch {
          status.textContent = 'Select the text above and copy it.';
        }
      }),
    );
</script>
