---
import OrderCard from '../components/OrderCard.astro';
import Site from '../layouts/Site.astro';
import { nonCancelledOrderStatuses } from '../server/order-statuses';
import { marketApi, messageFor } from '../server/market';
Astro.response.headers.set('Cache-Control', 'no-store');
let orders: Awaited<
  ReturnType<ReturnType<typeof marketApi>['orders']['list']['query']>
> = [];
let error = '';
const includeCancelled = Astro.url.searchParams.get('includeCancelled') === '1';
let markets: Awaited<
  ReturnType<ReturnType<typeof marketApi>['markets']['list']['query']>
> = [];
try {
  const api = marketApi(Astro);
  if (!(await api.me.query())) return Astro.redirect('/account', 303);
  if (Astro.request.method === 'POST') {
    const form = await Astro.request.formData();
    await api.orders.cancel.mutate({ id: String(form.get('orderId') || '') });
    return Astro.redirect(
      '/orders?cancelled=1' + (includeCancelled ? '&includeCancelled=1' : ''),
      303,
    );
  }
  [orders, markets] = await Promise.all([
    api.orders.list.query({
      scope: 'mine',
      limit: 100,
      statuses: includeCancelled ? [] : nonCancelledOrderStatuses,
    }),
    api.markets.list.query(),
  ]);
} catch (problem) {
  error = messageFor(problem);
}
---

<Site title="Your orders — Silverstreak">
  <section class="shop-page">
    <p class="small-label">From the market to your door</p>
    <h1>Your orders.</h1>
    <div class="shop-links">
      <a href="/order">Shop the market</a>
    </div>
    {Astro.url.searchParams.has('placed') && (
      <p class="shop-notice" role="status">
        Your order is placed. We’ll take it from here.
      </p>
    )}
    {Astro.url.searchParams.has('cancelled') && (
      <p class="shop-notice" role="status">
        Your order has been cancelled.
      </p>
    )}
    {error && (
      <p class="shop-notice" role="alert">
        {error}
      </p>
    )}
    {!error && !orders.length && (
      <p class="shop-empty">
        No orders to show. <a href="/order">See what’s available.</a>
      </p>
    )}
    <div class="order-list">
      {orders.map((order) => (
        <OrderCard
          order={order}
          timezone={
            markets.find((market) => market.id === order.run.marketId)
              ?.timezone || 'UTC'
          }
        >
          {order.status === 'placed' && (
            <form method="post" data-confirm-cancel>
              <input type="hidden" name="orderId" value={order.id} />
              <button class="quiet-button">Cancel order</button>
            </form>
          )}
        </OrderCard>
      ))}
    </div>
    <form method="get" class="orders-filter">
      <label>
        <input
          type="checkbox"
          name="includeCancelled"
          value="1"
          checked={includeCancelled}
        />
        Show cancelled orders
      </label>
      <noscript>
        <button class="quiet-button">Update view</button>
      </noscript>
    </form>
  </section>
</Site>

<script>
  const filter = document.querySelector<HTMLFormElement>('.orders-filter');
  filter?.querySelector('input')?.addEventListener('change', () => {
    filter?.requestSubmit();
  });

  document
    .querySelectorAll<HTMLFormElement>('[data-confirm-cancel]')
    .forEach((form) => {
      form.addEventListener('submit', (event) => {
        if (!window.confirm('Cancel this order? This cannot be undone.')) {
          event.preventDefault();
        }
      });
    });
</script>
